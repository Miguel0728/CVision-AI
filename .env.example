# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# --- Obligatorio ---
OPENAI_API_KEY=

# --- Seguridad (en producción define SIEMPRE los dos primeros) ---
# Clave para firmar las respuestas del agente (mínimo 32 caracteres aleatorios).
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
# Dominios con los que se puede acceder a la app, separados por comas. En Render: tu-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Proxies de confianza delante de la app. Render: 3 (Cloudflare + balanceador interno). Local: 0 (se ignora X-Forwarded-For).
PROXY_HOPS=0
# Publica /docs y /openapi.json (solo para desarrollo).
ENABLE_DOCS=false

# --- Límites de la demostración (protegen el gasto) ---
DEMO_DAILY_TOKEN_BUDGET=300000
DEMO_REQUESTS_PER_HOUR=20
API_REQUESTS_PER_MINUTE=120
IP_REQUESTS_PER_HOUR=60
MAX_COMPLETION_TOKENS=700
MAX_BODY_BYTES=65536

# --- Modelo ---
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=none

# --- Almacenamiento (en Render con disco persistente: /var/data/...) ---
USAGE_DB_PATH=
OUTBOX_DB_PATH=
